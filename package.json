{
  "name": "minecraft-magic-blueprint",
  "version": "0.1.0",
  "description": "A web-based 2D/3D editor for designing Minecraft structures",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:atlas && tsc && vite build",
    "build:atlas": "tsx scripts/buildTextureAtlas.ts --pack squareful",
    "build:atlas:squareful": "npm run build:atlas -- --pack squareful",
    "build:atlas:excaliber": "npm run build:atlas -- --pack excaliber",
    "parse:pack": "tsx scripts/parseResourcePack.ts",
    "merge:fragments": "tsx scripts/mergeTextureFragments.ts data/canonical-blocks.json public/data/canonical-blocks.json",
    "generate:manifest": "tsx scripts/generatePackManifest.ts",
    "generate:env": "tsx scripts/generateEnvironments.ts",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@babylonjs/core": "^7.45.1",
    "@babylonjs/loaders": "^7.45.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/lab": "^7.0.1-beta.22",
    "@mui/material": "^7.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^2.3.3"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.0.18",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "minecraft",
    "blueprint",
    "editor",
    "3d",
    "voxel"
  ],
  "author": "",
  "license": "ISC"
}
